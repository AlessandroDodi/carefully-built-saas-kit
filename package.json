{
  "name": "carefully-built-saas-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "build:vercel": "bun run --sequential --filter './packages/*' build",
    "check": "bun run typecheck && bun run knip && bun run build",
    "docs": "node scripts/generate-docs.mjs",
    "knip": "knip",
    "typecheck": "bun run --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "knip": "^6.14.1",
    "tsdown": "^0.17.0",
    "typescript": "^5.0.0"
  }
}
