{
  "name": "@carefully-built/import-export",
  "version": "0.1.5",
  "description": "Reusable tabular import/export for SaaS apps: CSV and Excel import with column mapping, dedupe and preview, CSV export.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.tsx --format esm --dts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "read-excel-file": "^9.3.14",
    "write-excel-file": "^4.1.1"
  },
  "peerDependencies": {
    "@carefully-built/ui": ">=0.1.24",
    "lucide-react": ">=0.468.0",
    "papaparse": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@carefully-built/ui": "workspace:*",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lucide-react": "^0.475.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.1"
  }
}
