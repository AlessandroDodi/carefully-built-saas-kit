{
  "name": "@carefully-built/custom-fields",
  "version": "0.1.4",
  "description": "Reusable custom-field options, form mapping, payload building, and display helpers for SaaS apps.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@carefully-built/forms": ">=0.1.5",
    "@carefully-built/ui": ">=0.1.15",
    "lucide-react": ">=0.400.0 || >=1.0.0",
    "react": ">=18.2.0 || >=19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "devDependencies": {
    "@carefully-built/forms": "workspace:*",
    "@carefully-built/ui": "workspace:*",
    "lucide-react": "^1.8.0",
    "react": "^19.2.3",
    "react-hook-form": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@carefully-built/forms": {
      "optional": true
    },
    "@carefully-built/ui": {
      "optional": true
    }
  }
}
