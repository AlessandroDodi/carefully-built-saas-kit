{
  "name": "@carefully-built/elevenlabs",
  "version": "0.1.6",
  "description": "Typed, fetch-only client for ElevenLabs Agents (outbound calls, phone numbers, conversations) and post-call webhook verification.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "homepage": "https://github.com/AlessandroDodi/carefully-built-saas-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroDodi/carefully-built-saas-kit.git",
    "directory": "packages/elevenlabs"
  },
  "bugs": {
    "url": "https://github.com/AlessandroDodi/carefully-built-saas-kit/issues"
  },
  "keywords": [
    "elevenlabs",
    "voice-agent",
    "outbound-calls",
    "webhook"
  ],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
