{
  "name": "@carefully-built/automations",
  "version": "0.1.2",
  "description": "Reusable automation builder primitives, canvas, options, and draft validation for SaaS apps.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.tsx --format esm --dts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@carefully-built/ui": ">=0.1.12",
    "@xyflow/react": "^12.10.2",
    "lucide-react": "^0.475.0 || ^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@carefully-built/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carefully-built/ui": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xyflow/react": "^12.10.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}
