{
  "name": "@carefully-built/superadmin",
  "version": "0.1.8",
  "description": "Reusable superadmin UI for Carefully Built SaaS apps.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "homepage": "https://github.com/AlessandroDodi/carefully-built-saas-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroDodi/carefully-built-saas-kit.git",
    "directory": "packages/superadmin"
  },
  "bugs": {
    "url": "https://github.com/AlessandroDodi/carefully-built-saas-kit/issues"
  },
  "keywords": [
    "react",
    "superadmin",
    "admin",
    "saas"
  ],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs",
      "default": "./dist/next.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/server.ts src/next.tsx --format esm --dts --unbundle",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@carefully-built/app-shell": ">=0.1.2",
    "@carefully-built/ui": ">=0.1.15",
    "lucide-react": ">=0.400.0 || >=1.0.0",
    "next": ">=15.0.0 || >=16.0.0",
    "react": ">=18.2.0 || >=19.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0",
    "recharts": ">=2.0.0",
    "sonner": ">=1.0.0 || >=2.0.0"
  },
  "peerDependenciesMeta": {
    "@carefully-built/app-shell": {
      "optional": true
    },
    "@carefully-built/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carefully-built/app-shell": "workspace:*",
    "@carefully-built/ui": "workspace:*",
    "@types/node": "^24.0.0",
    "lucide-react": "^1.8.0",
    "next": "^16.0.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7"
  }
}
