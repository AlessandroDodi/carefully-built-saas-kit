{
  "name": "@carefully-built/notes",
  "version": "0.1.2",
  "description": "Reusable notes cards, grids, helpers, and editor shell pieces for SaaS apps.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "homepage": "https://github.com/AlessandroDodi/carefully-built-saas-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroDodi/carefully-built-saas-kit.git",
    "directory": "packages/notes"
  },
  "bugs": {
    "url": "https://github.com/AlessandroDodi/carefully-built-saas-kit/issues"
  },
  "keywords": ["react", "notes", "saas", "markdown", "rich-text"],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@carefully-built/crud": ">=0.1.0",
    "@carefully-built/resource-kit": ">=0.1.0",
    "@carefully-built/rich-text": ">=0.1.0",
    "@carefully-built/search": ">=0.1.0",
    "@carefully-built/ui": ">=0.1.14",
    "lucide-react": ">=0.468.0",
    "nuqs": ">=2.0.0",
    "react": ">=18.2.0 || >=19.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0",
    "sonner": ">=1.0.0 || >=2.0.0"
  },
  "peerDependenciesMeta": {
    "@carefully-built/crud": {
      "optional": true
    },
    "@carefully-built/resource-kit": {
      "optional": true
    },
    "@carefully-built/rich-text": {
      "optional": true
    },
    "@carefully-built/search": {
      "optional": true
    },
    "@carefully-built/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carefully-built/crud": "file:../crud/carefully-built-crud-0.1.2.tgz",
    "@carefully-built/resource-kit": "file:../resource-kit/carefully-built-resource-kit-0.1.2.tgz",
    "@carefully-built/rich-text": "file:../rich-text/carefully-built-rich-text-0.1.0.tgz",
    "@carefully-built/search": "file:../search/carefully-built-search-0.1.1.tgz",
    "@carefully-built/ui": "file:../ui/carefully-built-ui-0.1.14.tgz",
    "lucide-react": "^0.475.0",
    "nuqs": "^2.8.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7"
  }
}
