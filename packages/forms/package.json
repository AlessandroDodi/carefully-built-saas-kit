{
  "name": "@carefully-built/forms",
  "version": "0.1.4",
  "description": "Reusable React Hook Form fields and schema-driven form helpers for Carefully Built SaaS apps.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "homepage": "https://github.com/AlessandroDodi/carefully-built-saas-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroDodi/carefully-built-saas-kit.git",
    "directory": "packages/forms"
  },
  "bugs": {
    "url": "https://github.com/AlessandroDodi/carefully-built-saas-kit/issues"
  },
  "keywords": [
    "react",
    "forms",
    "react-hook-form",
    "saas",
    "zod"
  ],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@carefully-built/agent-picker": ">=0.1.0",
    "@carefully-built/association-picker": ">=0.1.1",
    "@carefully-built/ui": ">=0.1.14",
    "@hookform/resolvers": ">=5.0.0",
    "lucide-react": ">=0.400.0 || >=1.0.0",
    "react": ">=18.2.0 || >=19.0.0",
    "react-country-flag": ">=3.0.0",
    "react-day-picker": ">=9.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0",
    "react-hook-form": ">=7.0.0",
    "react-phone-number-input": ">=3.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@carefully-built/agent-picker": {
      "optional": true
    },
    "@carefully-built/association-picker": {
      "optional": true
    },
    "@carefully-built/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carefully-built/agent-picker": "file:../agent-picker/carefully-built-agent-picker-0.1.0.tgz",
    "@carefully-built/association-picker": "file:../association-picker/carefully-built-association-picker-0.1.1.tgz",
    "@carefully-built/ui": "file:../ui/carefully-built-ui-0.1.14.tgz",
    "@hookform/resolvers": "^5.2.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.3",
    "react-country-flag": "^3.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "react-phone-number-input": "^3.4.16",
    "zod": "^4.3.6"
  }
}
