{
  "name": "@carefully-built/agenda",
  "version": "0.1.6",
  "description": "Reusable agenda helpers, activity lists, time utilities, and activity type primitives for SaaS apps.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.tsx --format esm --dts && cp src/styles.css dist/styles.css",
