{
  "name": "@carefully-built/auth-pages",
  "version": "0.1.7",
  "description": "Reusable SaaS auth pages, layouts, legal consent, and form presentation for Carefully Built apps.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "homepage": "https://github.com/AlessandroDodi/carefully-built-saas-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroDodi/carefully-built-saas-kit.git",
    "directory": "packages/auth-pages"
  },
  "bugs": {
    "url": "https://github.com/AlessandroDodi/carefully-built-saas-kit/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "auth",
    "saas",
    "workos"
  ],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./forms": {
      "types": "./dist/forms.d.mts",
      "import": "./dist/forms.mjs",
      "default": "./dist/forms.mjs"
    },
    "./controllers": {
      "types": "./dist/controllers.d.mts",
      "import": "./dist/controllers.mjs",
      "default": "./dist/controllers.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./social": {
      "types": "./dist/social.d.mts",
      "import": "./dist/social.mjs",
      "default": "./dist/social.mjs"
    },
    "./workos": {
      "types": "./dist/workos.d.mts",
      "import": "./dist/workos.mjs",
      "default": "./dist/workos.mjs"
    },
    "./organizations": {
      "types": "./dist/organizations.d.mts",
      "import": "./dist/organizations.mjs",
      "default": "./dist/organizations.mjs"
    },
    "./pages": {
      "types": "./dist/pages.d.mts",
      "import": "./dist/pages.mjs",
      "default": "./dist/pages.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/forms.ts src/controllers.ts src/config.ts src/social.ts src/workos.ts src/organizations.ts src/pages.ts --format esm --dts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@carefully-built/forms": ">=0.1.0",
    "@carefully-built/ui": ">=0.1.4",
    "@hookform/resolvers": ">=5.0.0",
    "react": ">=18.2.0 || >=19.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0",
    "react-hook-form": ">=7.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@carefully-built/forms": {
      "optional": true
    },
    "@carefully-built/ui": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carefully-built/forms": "file:../forms/carefully-built-forms-0.1.0.tgz",
    "@carefully-built/ui": "file:../ui/carefully-built-ui-0.1.4.tgz",
    "@hookform/resolvers": "^5.2.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "zod": "^4.3.6"
  }
}
