{
  "name": "@carefully-built/elevenlabs-react",
  "version": "0.1.1",
  "description": "React hook for talking to an ElevenLabs agent from the browser (microphone, WebRTC), with the token fetched from your own backend.",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Dodi",
  "homepage": "https://github.com/AlessandroDodi/carefully-built-saas-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroDodi/carefully-built-saas-kit.git",
    "directory": "packages/elevenlabs-react"
  },
  "bugs": {
    "url": "https://github.com/AlessandroDodi/carefully-built-saas-kit/issues"
  },
  "keywords": ["elevenlabs", "voice-agent", "react", "webrtc"],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": { "access": "public" },
  "dependencies": { "@elevenlabs/react": "^1.21.1" },
  "peerDependencies": { "react": ">=18.2.0 || >=19.0.0" }
}
